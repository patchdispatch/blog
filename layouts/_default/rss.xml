{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.LanguageCode }}</language>
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- range first 30 $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | plainify | html }}</description>
    </item>
    {{- with .Params.updated }}
    <item>
      <title>Updated: {{ $.Title }}</title>
      <link>{{ $.Permalink }}#timeline-of-updates</link>
      <pubDate>{{ (time.AsTime .).Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="false">{{ $.Permalink }}#updated-{{ . }}</guid>
      <description>New information was added to this post's timeline of updates.</description>
    </item>
    {{- end }}
    {{- end }}
  </channel>
</rss>
